<Window x:Class="YTools.UI.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:YTools.UI"
        xmlns:ModuleKit="clr-namespace:YTools.ModuleKit"
        xmlns:Models="clr-namespace:YTools.Models"
        Title="YTools"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Width="720"
        Height="196"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="OnPreviewKeyDown"
        Deactivated="OnDeactivated">
    <Window.Resources>
        <ui:ResultIconConverter x:Key="ResultIconConverter" />
        <ui:IsFileIconConverter x:Key="IsFileIconConverter" />
        <ui:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <ui:CountToVisibilityConverter x:Key="CountToVisibility" />
        <ui:NumberBadgeConverter x:Key="NumberBadge" />
        <ui:StringEmptyToVisibilityConverter x:Key="StringEmptyToVisibility" />
        <Style x:Key="ResultItemStyle" TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row"
                                CornerRadius="9"
                                Background="Transparent"
                                Padding="10,4">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource SelectionBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="{Binding ResultRowHeight, RelativeSource={RelativeSource AncestorType=Window}}" />
        </Style>
        <DataTemplate x:Key="ResultTemplate" DataType="{x:Type ModuleKit:LauncherResult}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Width="34" Height="34" VerticalAlignment="Center">
                    <Image Source="{Binding Icon, Converter={StaticResource ResultIconConverter}}"
                           Width="30" Height="30"
                           Visibility="{Binding Icon, Converter={StaticResource IsFileIconConverter}}" />
                    <TextBlock Text="{Binding Icon, Converter={StaticResource ResultIconConverter}}"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="20"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Visibility="{Binding Icon, Converter={StaticResource IsFileIconConverter}, ConverterParameter=invert}" />
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding DataContext.ShowSubtitles, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <TextBlock Grid.Column="2"
                           Text="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource NumberBadge}}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Visibility="{Binding DataContext.ShowNumberShortcuts, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="ActionTemplate" DataType="{x:Type Models:LauncherAction}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding SystemIcon, Converter={StaticResource ResultIconConverter}}"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="20"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}"
                               FontSize="15"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <Grid ClipToBounds="True">
        <Border x:Name="PanelBorder"
                CornerRadius="14"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.35" Color="Black" />
            </Border.Effect>
        </Border>
        <Grid Margin="1" ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="MainColumn" Width="*" />
                <ColumnDefinition x:Name="PreviewColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="HeaderRow" Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition x:Name="FooterRow" Height="Auto" />
                </Grid.RowDefinitions>
                <Border x:Name="HeaderBorder"
                        Grid.Row="0"
                        Background="Transparent"
                        MouseLeftButtonDown="OnHeaderMouseDown">
                    <StackPanel Margin="18,0"
                                VerticalAlignment="Center">
                        <!-- Keep the input row's measure stable.  Without an explicit
                             height the StackPanel is stretched by an idle header and
                             lays its first child out at the top, which makes the text
                             look off-centre while the results row is collapsed. -->
                        <Grid Height="40"
                              VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="&#xE721;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="18"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,10,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False" />
                            <Grid Grid.Column="1">
                                <TextBlock Text="搜索应用、文件和工具"
                                           FontSize="16"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Visibility="{Binding Query, Converter={StaticResource StringEmptyToVisibility}}" />
                            <TextBox x:Name="SearchBox"
                                     Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                                     Height="40"
                                     FontSize="18"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     CaretBrush="{DynamicResource TextPrimaryBrush}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0"
                                     VerticalContentAlignment="Center"
                                     VerticalAlignment="Center"
                                     SpellCheck.IsEnabled="False"
                                     ContextMenu="{x:Null}"
                                     AutomationProperties.Name="搜索" />
                            </Grid>
                            <Button Grid.Column="2"
                                    Width="30"
                                    Height="30"
                                    Margin="6,0,0,0"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="13"
                                    Content="&#xE711;"
                                    ToolTip="清除搜索 (Esc)"
                                    Cursor="Hand"
                                    Click="OnClearSearchClick"
                                    Visibility="{Binding Query, Converter={StaticResource StringEmptyToVisibility}, ConverterParameter=invert}" />
                            <Border Grid.Column="3"
                                    Margin="8,0,0,0"
                                    Padding="10,3"
                                    CornerRadius="10"
                                    Background="{DynamicResource InputBackgroundBrush}"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding FileBuffer.Count, Converter={StaticResource CountToVisibility}, FallbackValue=Collapsed}">
                                <TextBlock Text="{Binding FileBuffer.Count, StringFormat=缓冲区 {0}}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>
                        </Grid>
                        <ProgressBar Height="2"
                                     Margin="28,0,0,0"
                                     BorderThickness="0"
                                     Foreground="{DynamicResource AccentBrush}"
                                     Background="Transparent"
                                     IsIndeterminate="True"
                                     IsHitTestVisible="False"
                                     Visibility="{Binding IsSearchPending, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock x:Name="HotKeyErrorText"
                                   Foreground="{DynamicResource ErrorBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,6"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Border>
                <!-- A zero-height body can still arrange ListBox children outside its
                     allocated row.  Clip it so an idle/collapsed launcher never paints
                     stale result text underneath the search field. -->
                <Grid Grid.Row="1" ClipToBounds="True">
                    <ListBox x:Name="ResultsList"
                             ItemsSource="{Binding Results}"
                             SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource ResultItemStyle}"
                             ItemTemplate="{StaticResource ResultTemplate}"
                             AlternationCount="10"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             KeyboardNavigation.TabNavigation="None"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             MouseDoubleClick="OnResultsDoubleClick"
                             AutomationProperties.Name="搜索结果"
                             Visibility="{Binding IsShowingActions, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                    <ListBox x:Name="ActionsList"
                             ItemsSource="{Binding Actions}"
                             SelectedIndex="{Binding SelectedActionIndex, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource ResultItemStyle}"
                             ItemTemplate="{StaticResource ActionTemplate}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             KeyboardNavigation.TabNavigation="None"
                             MouseDoubleClick="OnActionsDoubleClick"
                             AutomationProperties.Name="可用操作"
                             Visibility="{Binding IsShowingActions, Converter={StaticResource BoolToVisibility}}" />
                    <StackPanel x:Name="EmptyState"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <TextBlock Text="&#xE721;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="24"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   Opacity="0.65" />
                        <TextBlock Text="没有找到匹配结果"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="0,8,0,0"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="试试更短的名称、拼音或应用别名"
                                   FontSize="12"
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"
                                Visibility="{Binding IsSearchPending, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="正在搜索…"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Grid>
                <Border x:Name="FooterBar"
                        Grid.Row="2"
                        Height="34"
                        Background="Transparent"
                        Visibility="Collapsed">
                    <Grid Margin="18,8">
                        <TextBlock Text="↑↓ 选择 · Enter 打开 · → 动作 · ⇧ 预览 · Ctrl+数字 直达"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Left" />
                        <TextBlock x:Name="BackendStatusText"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Right"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>
            </Grid>
            <ui:PreviewPanel x:Name="PreviewPane" Grid.Column="1" />
        </Grid>
    </Grid>
</Window>
