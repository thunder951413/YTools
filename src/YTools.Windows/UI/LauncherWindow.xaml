<Window x:Class="YTools.UI.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:YTools.UI"
        xmlns:ModuleKit="clr-namespace:YTools.ModuleKit"
        xmlns:Models="clr-namespace:YTools.Models"
        Title="YTools"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Width="720"
        Height="196"
        PreviewKeyDown="OnPreviewKeyDown"
        Deactivated="OnDeactivated">
    <Window.Resources>
        <ui:ResultIconConverter x:Key="ResultIconConverter" />
        <ui:IsFileIconConverter x:Key="IsFileIconConverter" />
        <ui:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <ui:CountToVisibilityConverter x:Key="CountToVisibility" />
        <ui:NumberBadgeConverter x:Key="NumberBadge" />
        <Style x:Key="ResultItemStyle" TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row"
                                CornerRadius="9"
                                Background="Transparent"
                                Padding="10,4">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource SelectionBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <DataTemplate x:Key="ResultTemplate" DataType="{x:Type ModuleKit:LauncherResult}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Width="34" Height="34" VerticalAlignment="Center">
                    <Image Source="{Binding Icon, Converter={StaticResource ResultIconConverter}}"
                           Width="30" Height="30"
                           Visibility="{Binding Icon, Converter={StaticResource IsFileIconConverter}}" />
                    <TextBlock Text="{Binding Icon, Converter={StaticResource ResultIconConverter}}"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="20"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Visibility="{Binding Icon, Converter={StaticResource IsFileIconConverter}, ConverterParameter=invert}" />
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding DataContext.ShowSubtitles, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <TextBlock Grid.Column="2"
                           Text="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource NumberBadge}}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Visibility="{Binding DataContext.ShowNumberShortcuts, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="ActionTemplate" DataType="{x:Type Models:LauncherAction}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding SystemIcon, Converter={StaticResource ResultIconConverter}}"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="20"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}"
                               FontSize="15"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Border x:Name="PanelBorder"
                CornerRadius="14"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.35" Color="Black" />
            </Border.Effect>
        </Border>
        <Grid Margin="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="MainColumn" Width="*" />
                <ColumnDefinition x:Name="PreviewColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="HeaderRow" Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition x:Name="FooterRow" Height="Auto" />
                </Grid.RowDefinitions>
                <Border x:Name="HeaderBorder"
                        Grid.Row="0"
                        Background="Transparent"
                        MouseLeftButtonDown="OnHeaderMouseDown"
                        Cursor="SizeAll">
                    <Grid Margin="18,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox"
                                 Grid.Column="0"
                                 Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="18"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 CaretBrush="{DynamicResource TextPrimaryBrush}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0,8"
                                 VerticalContentAlignment="Center"
                                 SpellCheck.IsEnabled="False"
                                 ContextMenu="{x:Null}" />
                        <Border Grid.Column="1"
                                Margin="8,0,0,0"
                                Padding="10,3"
                                CornerRadius="10"
                                Background="{DynamicResource InputBackgroundBrush}"
                                VerticalAlignment="Center"
                                Visibility="{Binding FileBuffer.Count, Converter={StaticResource CountToVisibility}, FallbackValue=Collapsed}">
                            <TextBlock Text="{Binding FileBuffer.Count, StringFormat=缓冲区 {0}}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>
                    </Grid>
                </Border>
                <Grid Grid.Row="1">
                    <ListBox x:Name="ResultsList"
                             ItemsSource="{Binding Results}"
                             SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource ResultItemStyle}"
                             ItemTemplate="{StaticResource ResultTemplate}"
                             AlternationCount="10"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             KeyboardNavigation.TabNavigation="None"
                             Visibility="{Binding VisibleItemCount, Converter={StaticResource CountToVisibility}}" />
                    <ListBox x:Name="ActionsList"
                             ItemsSource="{Binding Actions}"
                             SelectedIndex="{Binding SelectedActionIndex, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource ResultItemStyle}"
                             ItemTemplate="{StaticResource ActionTemplate}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             KeyboardNavigation.TabNavigation="None"
                             Visibility="{Binding IsShowingActions, Converter={StaticResource BoolToVisibility}}" />
                    <StackPanel x:Name="EmptyState"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <TextBlock Text="输入以搜索应用、文件、计算、词典和工具"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Grid>
                <Border x:Name="FooterBar"
                        Grid.Row="2"
                        Height="34"
                        Background="Transparent"
                        Visibility="Collapsed">
                    <TextBlock Text="↑↓ 选择 · Enter 打开 · → 动作 · ⇧ 预览 · Ctrl+数字 直达"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="18,8"
                               HorizontalAlignment="Left" />
                </Border>
            </Grid>
            <ui:PreviewPanel x:Name="PreviewPane" Grid.Column="1" />
        </Grid>
    </Grid>
</Window>
