<Window x:Class="YTools.UI.TranslatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YTools AI 翻译"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="CanResizeWithGrip"
        Width="560"
        Height="440"
        MinWidth="420"
        MinHeight="320"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="OnPreviewKeyDown">
    <Grid>
        <Border CornerRadius="14"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.35" Color="Black" />
            </Border.Effect>
        </Border>
        <Grid Margin="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="16,12,12,8" Background="Transparent" MouseLeftButtonDown="OnHeaderMouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE8C1;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center"
                           Foreground="{DynamicResource AccentBrush}" />
                <TextBlock x:Name="DirectionText" Grid.Column="1" Margin="10,0,8,0" FontSize="14" FontWeight="SemiBold"
                           VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                <Button x:Name="SwapButton" Grid.Column="2" Content="&#xE8AB;" FontFamily="Segoe MDL2 Assets" Padding="8,4"
                        Click="Swap_Click" ToolTip="切换翻译方向（Ctrl+R）" AutomationProperties.Name="切换翻译方向" />
                <TextBlock x:Name="BusyText" Grid.Column="4" Text="正在翻译…" Margin="0,0,10,0" FontSize="12" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed" />
                <Button Grid.Column="5" Content="&#xE713;" FontFamily="Segoe MDL2 Assets" Padding="8,4" Margin="0,0,6,0"
                        Click="Settings_Click" ToolTip="AI 翻译设置" AutomationProperties.Name="AI 翻译设置" />
                <Button Grid.Column="6" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" Padding="8,4"
                        Click="Close_Click" ToolTip="关闭（Esc）" AutomationProperties.Name="关闭翻译窗口" />
            </Grid>
            <Border x:Name="DisabledNotice" Grid.Row="1" Margin="14,0,14,8" Padding="10,8" CornerRadius="8"
                    Background="{DynamicResource SelectionBrush}" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="AI 翻译尚未启用。在设置中选择服务商、填写 API Key 并打开开关后即可使用。" TextWrapping="Wrap"
                               FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <Button Grid.Column="1" Content="打开设置" Margin="10,0,0,0" Padding="10,4" Click="Settings_Click" />
                </Grid>
            </Border>
            <TextBox x:Name="InputBox" Grid.Row="2" Margin="14,0,14,0" Padding="10,8"
                     Tag="输入或粘贴要翻译的内容…"
                     FontSize="15"
                     AcceptsReturn="True" AcceptsTab="False" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     CaretBrush="{DynamicResource TextPrimaryBrush}"
                     Background="{DynamicResource InputBackgroundBrush}"
                     BorderThickness="0"
                     TextChanged="Input_TextChanged"
                     AutomationProperties.Name="待翻译文本" />
            <Border Grid.Row="3" Height="1" Margin="14,10" Background="{DynamicResource BorderBrush}" />
            <TextBox x:Name="OutputBox" Grid.Row="4" Margin="14,0,14,0" Padding="10,8"
                     FontSize="15" IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     Background="Transparent" BorderThickness="0"
                     AutomationProperties.Name="译文"
                     AutomationProperties.LiveSetting="Polite" />
            <Grid Grid.Row="5" Margin="16,8,20,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Content="清空" Padding="10,4" Click="Clear_Click" ToolTip="清空（Ctrl+K）" />
                <TextBlock x:Name="HintText" Grid.Column="1" Margin="12,0" FontSize="11" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondaryBrush}" />
                <Button x:Name="CopyButton" Grid.Column="2" Content="复制译文" Padding="10,4" Margin="0,0,8,0"
                        Click="Copy_Click" ToolTip="复制译文（Ctrl+Enter）" IsEnabled="False" />
                <Button x:Name="PasteButton" Grid.Column="3" Content="粘贴到应用" Padding="10,4"
                        Click="Paste_Click" ToolTip="关闭窗口并把译文粘贴到之前的应用（Ctrl+Shift+Enter）" IsEnabled="False" />
            </Grid>
        </Grid>
    </Grid>
</Window>
